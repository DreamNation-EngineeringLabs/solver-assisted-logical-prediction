\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Three-candidate rescoring, all three checkpoints: \texttt  {Unknown} responses out of 192 per arm, against three references. Detection predicts a \emph  {rise} under \textsc  {broken\_chain}. No checkpoint rises against the two records carrying no query-relevant material (\textsc  {none}, \textsc  {irrel.}); both checkpoints with abstention headroom rise against the surface-matched \textsc  {trunc\_1}. The sign is a function of the reference, which is why we rest no conclusion on it.\relax }}{13}{table.caption.11}\protected@file@percent }
\newlabel{tab:detection}{{6}{13}{Three-candidate rescoring, all three checkpoints: \texttt {Unknown} responses out of 192 per arm, against three references. Detection predicts a \emph {rise} under \textsc {broken\_chain}. No checkpoint rises against the two records carrying no query-relevant material (\textsc {none}, \textsc {irrel.}); both checkpoints with abstention headroom rise against the surface-matched \textsc {trunc\_1}. The sign is a function of the reference, which is why we rest no conclusion on it.\relax }{table.caption.11}{}}
\newlabel{tab:detection@cref}{{[table][6][2147483647]6}{[1][12][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Ten matched arms on one item set, differing only in the solver record. Left: correct on the entailed subset (of 96). Right: sensitivity $d'$, signed. Destroying validity alone removes almost the whole effect \emph  {on this checkpoint}; on gemma-3-4b it does not, see \cref  {sec:replication}. The \textsc  {misleading} arm, whose fabricated final rule points the wrong way, is followed to the wrong answer on 189 of 192 items.\relax }}{13}{figure.caption.12}\protected@file@percent }
\newlabel{fig:arms}{{2}{13}{Ten matched arms on one item set, differing only in the solver record. Left: correct on the entailed subset (of 96). Right: sensitivity $d'$, signed. Destroying validity alone removes almost the whole effect \emph {on this checkpoint}; on gemma-3-4b it does not, see \cref {sec:replication}. The \textsc {misleading} arm, whose fabricated final rule points the wrong way, is followed to the wrong answer on 189 of 192 items.\relax }{figure.caption.12}{}}
\newlabel{fig:arms@cref}{{[figure][2][2147483647]2}{[1][12][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The surface and validity components on three checkpoints. Gemma-3-4B's surface component is $+58.3$pp against $+1.0$pp for the two Qwen checkpoints. Bars give the decomposition against the \textsc  {irrelevant} control; the share annotation gives both denominators, $40.4\%$ against that control and $51.4\%$ against what the model manages unaided. The two coincide on the Qwen checkpoints, which score $0/96$ with no certificate, and diverge only where a substrate has competence of its own.\relax }}{14}{figure.caption.13}\protected@file@percent }
\newlabel{fig:replication}{{3}{14}{The surface and validity components on three checkpoints. Gemma-3-4B's surface component is $+58.3$pp against $+1.0$pp for the two Qwen checkpoints. Bars give the decomposition against the \textsc {irrelevant} control; the share annotation gives both denominators, $40.4\%$ against that control and $51.4\%$ against what the model manages unaided. The two coincide on the Qwen checkpoints, which score $0/96$ with no certificate, and diverge only where a substrate has competence of its own.\relax }{figure.caption.13}{}}
\newlabel{fig:replication@cref}{{[figure][3][2147483647]3}{[1][12][]14}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Three-candidate response distribution, three checkpoints, four arms. Dotted and dashed lines mark the \textsc  {none} and \textsc  {irrelevant} abstention baselines, $4.7$pp apart at 4-bit and $34.9$pp at bfloat16. A broken chain lowers abstention against \emph  {both} references on every checkpoint --- the opposite of the direction validity detection predicts.\relax }}{14}{figure.caption.14}\protected@file@percent }
\newlabel{fig:detection}{{4}{14}{Three-candidate response distribution, three checkpoints, four arms. Dotted and dashed lines mark the \textsc {none} and \textsc {irrelevant} abstention baselines, $4.7$pp apart at 4-bit and $34.9$pp at bfloat16. A broken chain lowers abstention against \emph {both} references on every checkpoint --- the opposite of the direction validity detection predicts.\relax }{figure.caption.14}{}}
\newlabel{fig:detection@cref}{{[figure][4][2147483647]4}{[1][12][]14}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Accuracy against the gap between the final rule and the premise it fires on --- all seven gaps, all three checkpoints, each checkpoint's canonical-order score dashed. Distance is flat. Direction is not: rule-after scores $26.8$, $22.4$ and $94.9\%$ against $5.8$, $4.8$ and $84.9\%$ for rule-before. Gemma-3-4B still answers $84.9\%$ of rule-before items correctly, so reversal degrades rather than prevents.\relax }}{15}{figure.caption.15}\protected@file@percent }
\newlabel{fig:order}{{5}{15}{Accuracy against the gap between the final rule and the premise it fires on --- all seven gaps, all three checkpoints, each checkpoint's canonical-order score dashed. Distance is flat. Direction is not: rule-after scores $26.8$, $22.4$ and $94.9\%$ against $5.8$, $4.8$ and $84.9\%$ for rule-before. Gemma-3-4B still answers $84.9\%$ of rule-before items correctly, so reversal degrades rather than prevents.\relax }{figure.caption.15}{}}
\newlabel{fig:order@cref}{{[figure][5][2147483647]5}{[1][12][]15}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces All five arms for all ten models, ordered by parameter count. Chance is $33.3\%$. Bar colour gives the per-arm viability verdict. Qwen2.5-7B is viable under \textsc  {conclusion\_only} and not under \textsc  {full}: viability is a property of (model $\times $ arm $\times $ runtime), not of a model.\relax }}{16}{figure.caption.16}\protected@file@percent }
